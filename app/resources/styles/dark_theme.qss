/* ============================================
   الوضع الداكن - تصميم فاخر
   ============================================ */

* {
    font-family: 'Cairo', 'Segoe UI', sans-serif;
    font-size: 12px;
    outline: none;
}

QMainWindow, QDialog {
    background-color: #0F172A;
}

QWidget {
    background-color: transparent;
    color: #E2E8F0;
}

#contentArea {
    background-color: #0F172A;
}

#pageHeader {
    background: #1E293B;
    border-bottom: 1px solid #334155;
    padding: 20px 25px;
}

#pageHeader QLabel#pageTitle {
    color: #F1F5F9;
    font-size: 20px;
    font-weight: 700;
}

#pageHeader QLabel#pageSubtitle {
    color: #94A3B8;
    font-size: 12px;
}

#card {
    background: #1E293B;
    border: 1px solid #334155;
    border-radius: 12px;
    padding: 20px;
}

#card:hover {
    border-color: #1976D3;
    box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
}

#cardTitle {
    color: #F1F5F9;
    font-size: 16px;
    font-weight: 600;
    padding-bottom: 10px;
    border-bottom: 2px solid #334155;
}

#kpiCard {
    background: #1E293B;
    border-radius: 16px;
    padding: 20px;
    border: 1px solid #334155;
}

#kpiCard QLabel#kpiValue {
    color: #F1F5F9;
    font-size: 24px;
    font-weight: 700;
}

#kpiCard QLabel#kpiLabel {
    color: #94A3B8;
    font-size: 12px;
}

QPushButton {
    background-color: #1E293B;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 8px 16px;
    color: #E2E8F0;
    font-weight: 500;
    min-height: 30px;
}

QPushButton:hover {
    background-color: #334155;
    border-color: #475569;
}

QPushButton#primaryButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #1976D3, stop:1 #42A5F5);
    border: none;
    color: white;
    font-weight: 600;
}

QLineEdit, QTextEdit, QSpinBox, QDoubleSpinBox, QDateEdit, QTimeEdit, QComboBox {
    background: #1E293B;
    border: 1.5px solid #334155;
    border-radius: 8px;
    padding: 8px 12px;
    color: #E2E8F0;
    selection-background-color: #1976D3;
    selection-color: white;
}

QLineEdit:focus, QTextEdit:focus, QSpinBox:focus, QComboBox:focus {
    border-color: #1976D3;
    box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.3);
}

QTableView, QTableWidget {
    background: #1E293B;
    border: 1px solid #334155;
    border-radius: 12px;
    gridline-color: #334155;
    selection-background-color: rgba(99, 102, 241, 0.3);
    selection-color: #F1F5F9;
    alternate-background-color: #1E293B;
}

QTableView::item, QTableWidget::item {
    padding: 8px;
    border-bottom: 1px solid #334155;
    color: #E2E8F0;
}

QHeaderView::section {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #1E293B, stop:1 #334155);
    color: #94A3B8;
    font-weight: 600;
    padding: 10px;
    border: none;
    border-bottom: 2px solid #475569;
    border-right: 1px solid #334155;
}

QTabWidget::pane {
    border: 1px solid #334155;
    border-radius: 12px;
    background: #1E293B;
    padding: 10px;
}

QTabBar::tab {
    background: transparent;
    color: #94A3B8;
    padding: 10px 20px;
    margin-right: 5px;
    border: none;
    border-bottom: 3px solid transparent;
    font-weight: 500;
}

QTabBar::tab:hover {
    color: #42A5F5;
    background: rgba(139, 92, 246, 0.1);
}

QTabBar::tab:selected {
    color: #42A5F5;
    border-bottom: 3px solid #42A5F5;
    font-weight: 600;
}

QScrollBar:vertical {
    background: transparent;
    width: 8px;
}

QScrollBar::handle:vertical {
    background: #475569;
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #64748B;
}

QMenu {
    background: #1E293B;
    border: 1px solid #334155;
    border-radius: 12px;
    padding: 8px;
}

QMenu::item {
    padding: 8px 20px;
    border-radius: 6px;
    color: #E2E8F0;
}

QMenu::item:selected {
    background: #1976D3;
    color: white;
}

QGroupBox {
    border: 2px solid #334155;
    border-radius: 12px;
    margin-top: 15px;
    padding-top: 15px;
    font-weight: 600;
    color: #94A3B8;
}

QCheckBox, QRadioButton {
    color: #E2E8F0;
    spacing: 8px;
}

QCheckBox::indicator, QRadioButton::indicator {
    border: 2px solid #475569;
    background: #1E293B;
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background: #1976D3;
    border-color: #1976D3;
}